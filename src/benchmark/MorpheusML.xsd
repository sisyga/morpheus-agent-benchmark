<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:complexType name="Lattice">
    <xs:complexContent>
      <xs:extension base="morphPlugin">
        <xs:annotation>
          <xs:documentation>Specifies the lattice by size, structure and boundary conditions.</xs:documentation>
        </xs:annotation>
        <xs:all>
          <xs:element name="Size">
            <xs:complexType>
              <xs:attribute name="value" use="required" type="cpmVectorMathExpression"/>
              <xs:attribute name="symbol" use="required" type="cpmVectorSymbolDef" default="size"/>
            </xs:complexType>
          </xs:element>
          <xs:element name="NodeLength" type="cpmLength" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Length of a lattice node.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="BoundaryConditions" type="cpmLatticeBoundaryConditions" minOccurs="0">
					</xs:element>
          <xs:element name="Domain" type="cpmDomain" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Specify a custom non-rectangular lattice domain using a predefined structure (cirle) or TIFF image.
							</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Neighborhood" type="cpmNeighborhood"/>
        </xs:all>
        <xs:attribute name="class" use="required" type="cpmLatticeStructure">
          <xs:annotation>
            <xs:documentation>Lattice structure.

							For non-spatial (ODE) models:

							1D: linear
							2D: square or hexagonal
							3D: cubic

							Note:
							- For non-spatial (ODE) models, choose 'linear' with size: 1 0 0.
						</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="cpmLatticeBoundaryConditions">
    <xs:all>
      <xs:element name="Condition" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="type" use="required" type="cpmBoundaryTypes"/>
          <xs:attribute name="boundary" use="required" type="cpmBoundary"/>
          <!-- 					<xs:attribute name="value" use="optional" type="cpmDouble" /> -->
        </xs:complexType>
      </xs:element>
    </xs:all>
  </xs:complexType>
  <xs:complexType name="cpmDomain">
    <xs:choice maxOccurs="1">
      <xs:element name="Circle">
        <xs:complexType>
          <xs:attribute name="diameter" use="required" type="cpmDouble"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="Hexagon">
        <xs:complexType>
          <xs:attribute name="diameter" use="required" type="cpmDouble"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="Image">
        <xs:complexType>
          <xs:attribute name="path" use="required" type="cpmSystemFile"/>
          <xs:attribute name="invert" use="optional" type="cpmBoolean" default="false"/>
        </xs:complexType>
        <xs:annotation>
          <xs:documentation>TIFF image (or image stack for 3D) that specifies the shape of domain.

						Note:
						- Non-zero pixels are interpreted as foreground, zero pixels are background.
						- Only 8-bit TIFF format is supported.
					</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
    <xs:attribute name="boundary-type" use="required" type="cpmDomainBoundaryTypes"/>
  </xs:complexType>
  <xs:simpleType name="cpmBoundaryTypes">
    <xs:annotation>
      <xs:documentation>Boundary conditions.
- Periodic (aka toroidal, wrap-around): specifies that the simulation domain is assumed to be replicated to form an infinite lattice.
- No-flux (aka Neumann): specifies the zero flux across the interface which leads to mass conservation within the simulation domain.
- Constant (aka Dirichlet): specifies a specific value to be fixed for the solution on the boundary point.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="cpmString">
      <xs:enumeration value="periodic"/>
      <xs:enumeration value="constant"/>
      <xs:enumeration value="noflux"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="cpmDomainBoundaryTypes">
    <xs:annotation>
      <xs:documentation>Domain Boundary conditions.
- No-flux (aka Neumann): specifies the zero flux across the interface which leads to mass conservation within the simulation domain.
- Constant (aka Dirichlet): specifies a specific value to be fixed for the solution on the boundary point.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="cpmString">
      <xs:enumeration value="constant"/>
      <xs:enumeration value="noflux"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="cpmBoundary">
    <xs:restriction base="cpmString">
      <xs:enumeration value="x"/>
      <xs:enumeration value="-x"/>
      <xs:enumeration value="y"/>
      <xs:enumeration value="-y"/>
      <xs:enumeration value="z"/>
      <xs:enumeration value="-z"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="cpmBoundaryRef">
    <xs:restriction base="cpmString">
      <xs:enumeration value="x"/>
      <xs:enumeration value="-x"/>
      <xs:enumeration value="y"/>
      <xs:enumeration value="-y"/>
      <xs:enumeration value="z"/>
      <xs:enumeration value="-z"/>
      <xs:enumeration value="domain"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="cpmLatticeStructure">
    <xs:restriction base="cpmString">
      <xs:enumeration value="linear"/>
      <xs:enumeration value="square"/>
      <xs:enumeration value="hexagonal-old"/>
      <xs:enumeration value="hexagonal"/>
      <xs:enumeration value="cubic"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="cpmNeighborhood">
    <xs:annotation>
      <xs:documentation>Number of neighboring lattice sites to take into account.</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="Order" type="cpmUnsignedInteger" default="1">
        <xs:annotation>
          <xs:documentation>Assuming a two dim. lattice order means
1: 4 neighbors (von Neumann)
2: 8 neighbors (Moore)
etc...</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Distance" type="cpmUnsignedDouble" default="1">
        <xs:annotation>
          <xs:documentation>Maximal distance to neighbor to take into account (in units of lattice nodes).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Name" type="cpmString">
        <xs:annotation>
          <xs:documentation>The only named neighborhood is "FCHC" for cubic lattices.
						This means: Face Centered HyperCube
					</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
  </xs:complexType>
  <xs:simpleType name="morphTags">
    <xs:restriction base="xs:string">
      <xs:pattern value="([\w-:]*)(?:\s*,\s*([\w-:]+))*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="morphPlugin">
    <xs:attribute name="name" type="cpmString" use="optional"/>
    <xs:attribute name="tags" type="morphTags" use="optional"/>
    <xs:all>
      <xs:element name="Annotation" type="morphText" minOccurs="0"/>
    </xs:all>
  </xs:complexType>
  <xs:complexType name="morphProcessPlugin">
    <xs:complexContent>
      <xs:extension base="morphPlugin">
        <xs:attribute name="time-step" type="cpmMathExpression" use="optional" default="1.0"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="morphInstantProcessPlugin">
    <xs:complexContent>
      <xs:extension base="morphPlugin">
        <xs:attribute name="time-step" type="cpmMathExpression" use="required" default="1.0"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="morphReporterPlugin">
    <xs:complexContent>
      <xs:extension base="morphPlugin">
        <xs:attribute name="time-step" type="cpmMathExpression" use="optional" default="1.0"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="morphAnalysisPlugin">
    <xs:complexContent>
      <xs:extension base="morphPlugin">
        <xs:attribute name="time-step" type="cpmMathExpression" use="required" default="1.0"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="CPMType">
    <!-- should be an extension of plugin ?? -->
    <xs:annotation>
      <xs:documentation>Let's you define all ingredients for a CPM simulation.</xs:documentation>
    </xs:annotation>
    <xs:all>
      <xs:element name="ShapeSurface">
        <xs:complexType>
          <xs:all>
            <xs:element name="Neighborhood" type="cpmNeighborhood"/>
          </xs:all>
          <xs:attribute name="scaling" use="required" type="cpmBoundaryScalingModes" default="norm"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="Interaction" type="Interaction"/>
      <xs:element name="MonteCarloSampler" type="MonteCarloSampler" minOccurs="0"/>
    </xs:all>
    <!--		<xs:attribute name="tags"	type="morphTags"			use="optional" />-->
  </xs:complexType>
  <xs:simpleType name="cpmBoundaryScalingModes">
    <xs:restriction base="cpmString">
      <xs:enumeration value="norm"/>
      <xs:enumeration value="size"/>
      <xs:enumeration value="none"/>
      <xs:enumeration value="classic"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="MonteCarloSampler">
    <xs:all>
      <xs:element name="MetropolisKinetics">
        <xs:complexType>
          <xs:annotation>
            <xs:documentation>Specifies the modified Metropolis algorithm used to stochastically find the minimal energy configuration.</xs:documentation>
          </xs:annotation>
          <xs:attribute name="temperature" type="cpmMathExpression" use="required" default="1"/>
          <xs:attribute name="yield" type="cpmMathExpression" use="optional" default="0.0"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="Neighborhood" type="cpmNeighborhood"/>
      <xs:element name="MCSDuration" minOccurs="1">
        <xs:complexType>
          <xs:attribute name="value" type="cpmUnsignedDouble" use="required" default="1"/>
          <xs:attribute name="symbol" type="cpmDoubleSymbolDef" use="optional" default="mcs_duration"/>
        </xs:complexType>
      </xs:element>
    </xs:all>
    <xs:attribute name="stepper" type="cpmStepper" use="required"/>
  </xs:complexType>
  <xs:simpleType name="cpmStepper">
    <xs:annotation>
      <xs:documentation>Monte Carlo sampling is done randomly (1) over whole lattice ("random"), or (2) on edges only ("edgelist").
Typically, "edgelist" is computationally much more efficient since updates can only take place at the interfaces of different domains (cell interfaces).</xs:documentation>
    </xs:annotation>
    <xs:restriction base="cpmString">
      <xs:enumeration value="edgelist"/>
      <xs:enumeration value="random"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="Interaction">
    <xs:all>
      <xs:element name="Contact" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:all>
            <xs:group ref="ContactPlugins"/>
          </xs:all>
          <xs:attribute name="type1" use="required" type="cpmCellTypeRef"/>
          <xs:attribute name="type2" use="required" type="cpmCellTypeRef"/>
          <xs:attribute name="value" use="required" type="cpmMathExpression"/>
        </xs:complexType>
      </xs:element>
    </xs:all>
    <xs:attribute name="default" use="optional" type="cpmDouble"/>
    <!--		<xs:attribute name="collapse" use="optional" type="cpmBoolean" default="true" /> -->
    <xs:attribute name="negative" use="optional" type="cpmBoolean" default="false">
      <xs:annotation>
        <xs:documentation>Use negative surface values when using SurfaceConstraint (Ouchi, 2003)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:element name="MorpheusModel" type="MorpheusModel"/>
  <xs:complexType name="MorpheusModel">
    <xs:all>
      <xs:element name="Description" type="Description"/>
      <xs:element name="Time" type="Time"/>
      <xs:element name="Space" type="Space"/>
      <xs:element name="Global" type="morphGlobals" minOccurs="0"/>
      <xs:element name="CPM" type="CPMType" minOccurs="0"/>
      <xs:element name="CellTypes" type="CellTypes" minOccurs="0"/>
      <xs:element name="Analysis" type="Analysis" minOccurs="0"/>
      <xs:element name="CellPopulations" type="CellPopulations" minOccurs="0"/>
    </xs:all>
    <xs:attribute name="version" type="cpmInteger" use="optional"/>
  </xs:complexType>
  <xs:group name="GlobalPlugins">
    <xs:all>
      <xs:element name="DelayVariable" type="DelayProperty" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="VectorEquation" type="VectorEquation" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Event" type="Event" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="System" type="System" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Constant" type="Constant" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="ConstantVector" type="ConstantVector" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Variable" type="Property" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="VariableVector" type="PropertyVector" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Function" type="Function" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="VectorFunction" type="VectorFunction" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Field" type="Field" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="VectorField" type="cpmVectorField" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Equation" type="Equation" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="VectorMapper" type="VectorMapping_t" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Mapper" type="Mapping_t" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="NeighborhoodVectorReporter" type="NeighborhoodVectorReporter" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="NeighborhoodReporter" type="NeighborhoodGlobalReporter" minOccurs="0" maxOccurs="unbounded"/>
    </xs:all>
  </xs:group>
  <xs:complexType name="Field">
    <xs:complexContent>
      <xs:extension base="morphPlugin">
        <xs:annotation>
          <xs:appinfo>Container</xs:appinfo>
        </xs:annotation>
        <xs:all>
          <xs:element name="Diffusion" type="cpmDiffusion" minOccurs="0"/>
          <!-- 			<xs:element name="BoundaryConditions"  type="cpmPDEBoundaryConditions" minOccurs="0" /> -->
          <xs:element name="BoundaryValue" type="cpmPDEBoundaryValue" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="Reduction" type="cpmBoundary" minOccurs="0"/>
          <!-- 			<xs:element name="Initial" minOccurs="0">
						<xs:group  ref="FieldInitPlugins" />
					</xs:element>-->
          <xs:element name="Data" type="cpmFieldData" minOccurs="0"/>
          <xs:element name="TIFFReader" type="TIFFReaderField" minOccurs="0"/>
        </xs:all>
        <xs:attribute name="symbol" type="cpmDoubleSymbolDef" use="required"/>
        <xs:attribute name="value" type="cpmMathExpression" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:group name="CellTypePlugins">
    <xs:all>
      <xs:element name="DelayProperty" type="DelayProperty" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="VectorEquation" type="VectorEquation" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Event" type="Event" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="System" type="System" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Constant" type="Constant" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="ConstantVector" type="ConstantVector" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Property" type="Property" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="PropertyVector" type="PropertyVector" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Variable" type="Property" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="VariableVector" type="PropertyVector" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="MembraneProperty" type="MembraneProperty" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Function" type="Function" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="VectorFunction" type="VectorFunction" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Equation" type="Equation" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="ConnectivityConstraint" type="ConnectivityConstraint" minOccurs="0"/>
      <xs:element name="LengthConstraint" type="LengthConstraint" minOccurs="0"/>
      <xs:element name="SurfaceConstraint" type="SurfaceConstraint" minOccurs="0"/>
      <xs:element name="VolumeConstraint" type="VolumeConstraint" minOccurs="0"/>
      <xs:element name="MotilityReporter" type="MotilityReporter" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="VectorMapper" type="VectorMapping_t" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Mapper" type="Mapping_t" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="NeighborhoodVectorReporter" type="NeighborhoodVectorReporter" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="NeighborhoodReporter" type="NeighborhoodCellTypeReporter" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="StarConvex" type="StarConvex" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Protrusion" type="Protrusion" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="FreezeMotion" type="FreezeMotion" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="PersistentMotion" type="PersistentMotion" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="DirectedMotion" type="DirectedMotion" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Haptotaxis" type="Haptotaxis" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Chemotaxis" type="Chemotaxis" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="InsertMedium" type="InsertMedium" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="ChangeCellType" type="ChangeCellType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="AddCell" type="AddCell" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="CellDeath" type="CellDeath" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="CellDivision" type="CellDivision" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="MechanicalLink" type="MechanicalLink" minOccurs="0" maxOccurs="1"/>
    </xs:all>
  </xs:group>
  <xs:complexType name="DelayProperty">
    <xs:complexContent>
      <xs:extension base="morphPlugin">
        <xs:annotation>
          <xs:appinfo>Container</xs:appinfo>
        </xs:annotation>
        <xs:attribute name="delay" type="cpmMathExpression" use="required" default="1"/>
        <xs:attribute name="symbol" type="cpmDoubleSymbolDef" use="required"/>
        <xs:attribute name="value" type="cpmMathExpression" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="DelayPropertyData">
    <xs:annotation>
      <!--PLUGIN CLASSES: Container / Shape / Motility / Math / Reporter / Misc-->
      <xs:appinfo>Container</xs:appinfo>
      <xs:documentation>Specify the numeric property of a cell that can be referenced via a symbol.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="symbol-ref" type="cpmDoubleSymbolRef" use="required"/>
    <xs:attribute name="value" type="cpmDelayData" use="required"/>
  </xs:complexType>
  <xs:simpleType name="cpmDelayData">
    <xs:restriction base="xs:string">
      <xs:pattern value="(\s*\(-?\d+(\.\d+)?(e[-\+]?\d{2})?\s*,\s*-?\d+(\.\d+)?(e[-\+]?\d{2})\)\s*\,?)*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="MembraneProperty">
    <xs:complexContent>
      <xs:extension base="morphPlugin">
        <xs:annotation>
          <!--PLUGIN CLASSES: Container / Shape / Motility / Math / Reporter / Misc-->
          <xs:appinfo>Container</xs:appinfo>
        </xs:annotation>
        <xs:all>
          <xs:element name="Diffusion" type="cpmDiffusion"/>
          <!--			<xs:element name="Initial" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Initial condition for MembraneProperty. </xs:documentation>
				</xs:annotation>
				<xs:group ref="FieldInitPlugins">
			</xs:element> -->
          <xs:element name="TIFFReader" type="TIFFReaderField" minOccurs="0"/>
          <xs:element name="Data" type="MembranePropertyData" minOccurs="0"/>
        </xs:all>
        <xs:attribute name="symbol" type="cpmDoubleSymbolDef" use="required"/>
        <xs:attribute name="value" type="cpmMathExpression" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="MembranePropertyData">
    <xs:simpleContent>
      <xs:extension base="cpmFieldData">
        <xs:attribute name="symbol-ref" type="cpmDoubleSymbolRef" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="ConnectivityConstraint">
    <xs:complexContent>
      <xs:extension base="morphPlugin">
        <xs:annotation>
          <xs:appinfo>Shape</xs:appinfo>
        </xs:annotation>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="LengthConstraint">
    <xs:complexContent>
      <xs:extension base="morphPlugin">
        <xs:annotation>
          <xs:appinfo>Shape</xs:appinfo>
        </xs:annotation>
        <xs:attribute name="target" type="cpmMathExpression" use="required" default="1"/>
        <xs:attribute name="strength" type="cpmMathExpression" use="required" default="1"/>
        <xs:attribute name="mode" type="cpmLCTargetMode" use="required" default="length"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:simpleType name="cpmLCTargetMode">
    <xs:restriction base="cpmString">
      <xs:enumeration value="length"/>
      <xs:enumeration value="eccentricity"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="SurfaceConstraint">
    <xs:complexContent>
      <xs:extension base="morphPlugin">
        <xs:annotation>
          <xs:appinfo>Shape</xs:appinfo>
        </xs:annotation>
        <xs:attribute name="mode" type="cpmSCTargetMode" use="required" default="aspherity"/>
        <xs:attribute name="target" type="cpmMathExpression" use="required" default="1"/>
        <xs:attribute name="strength" type="cpmMathExpression" use="required" default="1"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:simpleType name="cpmSCTargetMode">
    <xs:restriction base="cpmString">
      <xs:enumeration value="surface"/>
      <xs:enumeration value="aspherity"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="VolumeConstraint">
    <xs:complexContent>
      <xs:extension base="morphPlugin">
        <xs:annotation>
          <xs:appinfo>Shape</xs:appinfo>
        </xs:annotation>
        <xs:attribute name="target" type="cpmMathExpression" use="required" default="1"/>
        <xs:attribute name="strength" type="cpmMathExpression" use="required" default="1"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="MotilityReporter">
    <xs:complexContent>
      <xs:extension base="morphReporterPlugin">
        <xs:annotation>
          <xs:appinfo>Reporter</xs:appinfo>
        </xs:annotation>
        <xs:all minOccurs="0">
          <xs:element name="Displacement" type="cpmVectorPropertyRef" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Determine the mean square displacement of the cell in regular time intervals. </xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Velocity" type="cpmVectorPropertyRef" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Determine the cell velocity in regular time intervals. </xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:all>
        <xs:attribute name="time-step" type="cpmMathExpression" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="VectorMapping_t">
    <xs:complexContent>
      <xs:extension base="morphReporterPlugin">
        <xs:annotation>
          <xs:appinfo>Reporter</xs:appinfo>
        </xs:annotation>
        <xs:all>
          <xs:element name="Input">
            <xs:complexType>
