    <Field symbol="confinement_meiotic" value="-wall_energy*max(0,sqrt((space.x-min(132,max(100,space.x)))^2+(space.y-16)^2+(space.z-16)^2)-initial_radius_um)^2" />
    <Event time-step="0.1" trigger="when-true" name="Refresh prescribed geometry until adulthood">
