      <Intermediate symbol="field_theta" value="min(cache_A,if(space.z&gt;=base_z_um,acos(min(1,max(-1,(turn_y_um-space.y)/max(1e-8,sqrt((space.y-turn_y_um)^2+(space.z-base_z_um)^2))))),if(space.y&lt;turn_y_um,0,pi)))" />
      <Intermediate symbol="field_p2" value="(space.x-min(cache_Tx,max(origin_x_um,space.x)))^2+(space.y-proximal_y_um)^2+(space.z-base_z_um)^2" />
      <Intermediate symbol="field_t2" value="if(cache_A&lt;=0,1e12,(space.x-cache_Tx)^2+(space.y-(turn_y_um-turn_radius_um*cos(field_theta)))^2+(space.z-(base_z_um+turn_radius_um*sin(field_theta)))^2)" />
