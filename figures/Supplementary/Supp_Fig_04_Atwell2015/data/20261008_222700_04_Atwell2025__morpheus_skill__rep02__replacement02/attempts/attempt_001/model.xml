        <Intermediate symbol="centre_p2" value="(cell.center.x-min(turn_x_um,max(origin_x_um,cell.center.x)))^2+(cell.center.y-proximal_y_um)^2+(cell.center.z-base_z_um)^2" />
        <Intermediate symbol="centre_t2" value="if(turn_angle&lt;=0,1e12,(cell.center.x-turn_x_um)^2+(cell.center.y-(turn_y_um-turn_radius_um*cos(centre_theta)))^2+(cell.center.z-(base_z_um+turn_radius_um*sin(centre_theta)))^2)" />
        <Intermediate symbol="centre_d2" value="if(turn_angle&lt;pi,1e12,(cell.center.x-min(turn_x_um,max(dtc_x_um,cell.center.x)))^2+(cell.center.y-distal_y_um)^2+(cell.center.z-base_z_um)^2)" />
        <Intermediate symbol="centre_region" value="if(centre_p2&lt;=min(centre_t2,centre_d2),0,if(centre_t2&lt;=centre_d2,1,2))" />
        <Intermediate symbol="centre_mid_x" value="if(centre_region==0,min(turn_x_um,max(origin_x_um,cell.center.x)),if(centre_region==1,turn_x_um,min(turn_x_um,max(dtc_x_um,cell.center.x))))" />
        <Intermediate symbol="radial_x" value="cell.center.x-centre_mid_x" />
        <Intermediate symbol="centre_mid_y" value="if(centre_region==0,proximal_y_um,if(centre_region==1,turn_y_um-turn_radius_um*cos(centre_theta),distal_y_um))" />
        <Intermediate symbol="radial_y" value="cell.center.y-centre_mid_y" />
        <Intermediate symbol="centre_mid_z" value="if(centre_region==1,base_z_um+turn_radius_um*sin(centre_theta),base_z_um)" />
        <Intermediate symbol="radial_z" value="cell.center.z-centre_mid_z" />
        <Intermediate symbol="radial_norm" value="sqrt(radial_x^2+radial_y^2+radial_z^2)" />
        <Intermediate symbol="allowed_center_radius" value="max(0,gonad_radius_um-radius_um)" />
        <Intermediate symbol="centre_in_rachis_region" value="centre_region!=0" />
        <Intermediate symbol="projection_scale" value="if(centre_in_rachis_region,allowed_center_radius/max(1e-8,radial_norm)-1,min(0,allowed_center_radius/max(1e-8,radial_norm)-1))" />
        <VectorRule symbol-ref="boundary_correction">
          <Expression>projection_scale*radial_x,projection_scale*radial_y,projection_scale*radial_z</Expression>
        </VectorRule>
      </System>
      <Event name="Bind GLP1 near DTC" time-step="0.001393939393939394" trigger="when-true">
        <Condition>glp1==0 and distance_from_dtc_um&lt;notch_bind_um</Condition>
        <Rule symbol-ref="glp1">
          <Expression>1</Expression>
        </Rule>
      </Event>
      <Event name="Irreversible GLP1 loss" time-step="0.001393939393939394" trigger="when-true">
        <Condition>glp1==1 and distance_from_dtc_um&gt;=notch_loss_um</Condition>
        <Rule symbol-ref="glp1">
          <Expression>2</Expression>
        </Rule>
      </Event>
      <Event name="Commit to meiosis during G1" time-step="0.001393939393939394" trigger="when-true">
        <Condition>phase==0 and (gld1_active or gld2_active) and elapsed_hours&gt;1</Condition>
        <Rule symbol-ref="phase">
          <Expression>4</Expression>
        </Rule>
        <Rule symbol-ref="phase_clock_h">
          <Expression>0</Expression>
        </Rule>
        <Rule symbol-ref="phase_duration_h">
          <Expression>g1_fraction*cycle_duration_h</Expression>
        </Rule>
      </Event>
      <Event name="G1 to S" time-step="0.001393939393939394" trigger="when-true">
        <Condition>phase==0 and glp1==1 and phase_clock_h&gt;=phase_duration_h</Condition>
        <Rule symbol-ref="phase">
          <Expression>1</Expression>
        </Rule>
        <Rule symbol-ref="phase_clock_h">
          <Expression>0</Expression>
        </Rule>
        <Rule symbol-ref="phase_duration_h">
          <Expression>s_fraction*cycle_duration_h</Expression>
        </Rule>
      </Event>
      <Event name="S to G2" time-step="0.001393939393939394" trigger="when-true">
        <Condition>phase==1 and phase_clock_h&gt;=phase_duration_h</Condition>
        <Rule symbol-ref="phase">
          <Expression>2</Expression>
        </Rule>
        <Rule symbol-ref="phase_clock_h">
          <Expression>0</Expression>
        </Rule>
        <Rule symbol-ref="phase_duration_h">
          <Expression>max(dt_h,rand_norm(g2_fraction*cycle_duration_h,phase_cv*g2_fraction*cycle_duration_h))</Expression>
        </Rule>
      </Event>
      <Event name="G2 to M; mitotic division" time-step="0.001393939393939394" trigger="when-true">
        <Condition>phase==2 and phase_clock_h&gt;=phase_duration_h</Condition>
        <Rule symbol-ref="phase">
          <Expression>3</Expression>
        </Rule>
        <Rule symbol-ref="phase_clock_h">
          <Expression>0</Expression>
        </Rule>
        <Rule symbol-ref="phase_duration_h">
          <Expression>m_fraction*cycle_duration_h</Expression>
        </Rule>
        <Rule symbol-ref="division_ready">
          <Expression>1</Expression>
        </Rule>
      </Event>
      <Event name="M to G1" time-step="0.001393939393939394" trigger="when-true">
        <Condition>phase==3 and phase_clock_h&gt;=phase_duration_h</Condition>
        <Rule symbol-ref="phase">
          <Expression>0</Expression>
        </Rule>
        <Rule symbol-ref="phase_clock_h">
          <Expression>0</Expression>
        </Rule>
        <Rule symbol-ref="phase_duration_h">
          <Expression>max(dt_h,rand_norm(g1_fraction*cycle_duration_h,phase_cv*g1_fraction*cycle_duration_h))</Expression>
        </Rule>
      </Event>
      <Event name="Nonproliferative G1 to meiotic S" time-step="0.001393939393939394" trigger="when-true">
        <Condition>phase==4 and phase_clock_h&gt;=phase_duration_h</Condition>
        <Rule symbol-ref="phase">
          <Expression>5</Expression>
        </Rule>
        <Rule symbol-ref="phase_clock_h">
          <Expression>0</Expression>
        </Rule>
        <Rule symbol-ref="phase_duration_h">
          <Expression>s_fraction*cycle_duration_h</Expression>
        </Rule>
      </Event>
      <Event name="Meiotic S to prophase" time-step="0.001393939393939394" trigger="when-true">
        <Condition>phase==5 and phase_clock_h&gt;=phase_duration_h</Condition>
        <Rule symbol-ref="phase">
          <Expression>6</Expression>
        </Rule>
        <Rule symbol-ref="phase_clock_h">
          <Expression>0</Expression>
        </Rule>
      </Event>
      <Event name="Sex determination at 200 um" time-step="0.001393939393939394" trigger="when-true">
        <Condition>fate==0 and distance_from_dtc_um&gt;sex_decision_um and elapsed_hours&gt;1</Condition>
        <Rule symbol-ref="fate">
          <Expression>if(time_hph&lt;sex_switch_hph,1,2)</Expression>
        </Rule>
        <Rule symbol-ref="fate_clock_h">
          <Expression>0</Expression>
        </Rule>
      </Event>
      <Event name="Oocyte maturation" time-step="0.001393939393939394" trigger="when-true">
        <Condition>fate==2 and radius_um&gt;=oocyte_radius_um</Condition>
        <Rule symbol-ref="fate">
          <Expression>4</Expression>
        </Rule>
      </Event>
      <CellDivision division-plane="random" write-log="csv" trigger="when-true">
        <Condition>(division_ready==1 or (fate==1 and fate_clock_h&gt;=sperm_delay_h and sperm_divisions&lt;2)) and cell.volume&gt;=4</Condition>
        <Triggers>
          <Rule symbol-ref="division_ready">
            <Expression>0</Expression>
          </Rule>
          <Rule symbol-ref="phase_clock_h">
            <Expression>if(division_ready==1,0,phase_clock_h)</Expression>
          </Rule>
          <Rule symbol-ref="sperm_divisions">
            <Expression>sperm_divisions+(fate==1)</Expression>
          </Rule>
          <Rule symbol-ref="fate">
            <Expression>if(fate==1 and sperm_divisions==1,3,fate)</Expression>
          </Rule>
          <Rule symbol-ref="radius_um">
            <Expression>if(fate==1,if(sperm_divisions==1,sperm_radius_um,radius_um/2^(1/3)),radius_um)</Expression>
          </Rule>
        </Triggers>
      </CellDivision>
      <CellDeath name="Oogenic apoptosis or paired fertilisation">
        <Condition>cell.id==remove_oocyte_id or cell.id==remove_sperm_id or (time_hph&gt;=adult_time_hph and (fate==2 or fate==4) and distance_from_dtc_um&lt;oocyte_growth_um and rand_uni(0,1)&lt;1-(1-apoptosis_probability_per_h)^dt_h)</Condition>
      </CellDeath>
