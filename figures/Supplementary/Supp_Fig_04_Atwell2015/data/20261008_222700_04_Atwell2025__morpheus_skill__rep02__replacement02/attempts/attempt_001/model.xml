      <Parameter symbol="qy" />
      <Parameter symbol="qz" />
      <Expression>if(turn_angle&lt;pi,1e12,(qx-min(turn_x_um,max(dtc_x_um,qx)))^2+(qy-distal_y_um)^2+(qz-base_z_um)^2)</Expression>
    </Function>
    <Function symbol="midline_distance_um">
      <Parameter symbol="qx" />
      <Parameter symbol="qy" />
      <Parameter symbol="qz" />
