    <Function symbol="query_angle">
      <Parameter symbol="qx" />
      <Parameter symbol="qy" />
      <Parameter symbol="qz" />
      <Expression>min(turn_angle,if(qz&gt;=base_z_um,acos(min(1,max(-1,(turn_y_um-qy)/max(1e-8,sqrt((qy-turn_y_um)^2+(qz-base_z_um)^2))))),if(qy&lt;turn_y_um,0,pi)))</Expression>
    </Function>
