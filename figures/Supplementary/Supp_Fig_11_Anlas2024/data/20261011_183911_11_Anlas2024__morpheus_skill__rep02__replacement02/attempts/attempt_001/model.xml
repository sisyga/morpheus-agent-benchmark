                    <Expression>min(0.999,max(0.001,Wnt+0.02*dWnt+signal_noise*sqrt(0.02)*rand_norm(0,1)))</Expression>
                </Rule>
                <DiffEqn symbol-ref="Nodal">
                    <Expression>(0.85+0.15*Wnt-Nodal)/14</Expression>
                </DiffEqn>
                <DiffEqn symbol-ref="Bra">
                    <Expression>(Nodal*(0.12+(0.70+0.22*CHIR)*Wnt)-Bra)/4</Expression>
                </DiffEqn>
                <DiffEqn symbol-ref="Sox2">
                    <Expression>(0.08+0.87/(1+(Bra/0.45)^4)-Sox2)/6</Expression>
                </DiffEqn>
                <DiffEqn symbol-ref="Cdh2">
                    <Expression>(0.05+0.90*Bra^4/(0.45^4+Bra^4)-Cdh2)/5</Expression>
                </DiffEqn>
                <DiffEqn symbol-ref="Cdh1">
                    <Expression>(0.95-0.90*Bra^4/(0.45^4+Bra^4)-Cdh1)/5</Expression>
                </DiffEqn>
                <DiffEqn symbol-ref="Eomes">
                    <Expression>(Nodal*(1-Wnt)/(1+(neighbor_Wnt/0.35)^4)-Eomes)/10</Expression>
                </DiffEqn>
                <DiffEqn symbol-ref="Aldh1a2">
                    <Expression>(Nodal*(1-Wnt)*neighbor_Wnt/(0.15+neighbor_Wnt)-Aldh1a2)/12</Expression>
                </DiffEqn>
                <DiffEqn symbol-ref="age_h">
                    <Expression>1</Expression>
                </DiffEqn>
                <DiffEqn symbol-ref="target_area">
                    <Expression>growth_rate*target_area</Expression>
                </DiffEqn>
            </System>
            <CellDivision division-plane="random" write-log="csv">
                <Condition>age_h &gt;= cycle_h</Condition>
