            <System solver="Euler [fixed, O(1)]" time-step="0.02">
                <Intermediate symbol="priming" value="Nodal^8/(0.75^8+Nodal^8)" />
                <Intermediate symbol="threshold" value="0.5+inhibitor_gain*(Lefty-0.5)" />
                <Intermediate symbol="dWnt" value="priming*feedback_rate*Wnt*(1-Wnt)*(Wnt-threshold) + neighbor_coupling*(neighbor_Wnt-Wnt)" />
